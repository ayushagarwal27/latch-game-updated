# Copy this file to .env and fill in your values

# NeonDB PostgreSQL connection string
# Get it from: console.neon.tech → your project → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Server port (optional, defaults to 3001)
PORT=3001

# ── Solana settlement ─────────────────────────────────────────────────────────

# Solana RPC endpoint (defaults to devnet if not set)
SOLANA_RPC=https://api.devnet.solana.com

# Admin wallet private key — accepts either format:
#   Base58 string (export directly from Phantom: Settings → Security → Export Private Key)
#   OR a JSON byte array: [0,1,2,...]
# Your teammate who deployed the contract must call initialize(this_wallet_pubkey) once.
ADMIN_PRIVATE_KEY=your_base58_private_key_here

# The config PDA address — derive it after initialize() is called:
# node -e "const {PublicKey}=require('@solana/web3.js'); const PROGRAM=new PublicKey('EjhoLdwKGbvpp3ydY8nSFq89r4aJBswUeaXWZXX5tW8b'); const [pda]=PublicKey.findProgramAddressSync([Buffer.from('config'), new PublicKey('DEPLOYER_PUBKEY').toBuffer()], PROGRAM); console.log(pda.toBase58())"
CONFIG_PDA=<config_pda_address_here>
